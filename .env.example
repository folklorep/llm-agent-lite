# ===== 环境变量示例 =====
# 复制本文件为 .env 后填入真实值（.env 不要提交到 GitHub！）

# DeepSeek（火山方舟/智谱/通义 也兼容 OpenAI 格式，换 base_url + model 即可）
LLM_API_KEY=sk-在这里填你的key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# ===== 检索配置 =====
# 检索模式，三选一（实测数据见 README 的「RAG 检索优化」一节）：
#   keyword  只做关键词打分。快、免费、不调 API。       命中率 82%
#   vector   词袋向量 + TF-IDF + 余弦相似度。本地计算。  命中率 88%
#   rerank   粗排 + LLM 精排。最准，但每次多一次 API 调用。命中率 92%
RETRIEVAL_MODE=keyword

# 精排前的召回数量（只对 rerank 模式有效）
# 实验结论：召回深度是决定成败的关键 —— 召回 10 → 90%，召回 20 → 92%
# 原因是有少数问题的答案块排在 10 名之后，召不回来就永远看不到（召回失败）
RERANK_RECALL_N=20

# 最终返回几条给模型
RETRIEVAL_TOP_K=3

# ===== 其他 =====
DEBUG=false
